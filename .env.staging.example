# Profile: staging — pre-production mirror with production-like security.
# Install: php artisan env:install staging
# See docs/environment.md

# --- Application ---------------------------------------------------------------
# Core Laravel identity: app name, environment, encryption keys, debug mode, and
# public base URL. APP_KEY is the active encryption key; APP_PREVIOUS_KEYS holds
# comma-separated retired keys after `php artisan key:generate --force` (Laravel
# key rotation — see config/app.php previous_keys). Empty in fresh templates.
APP_NAME="Laravel"
APP_ENV="staging"
APP_KEY=""
APP_PREVIOUS_KEYS=""
APP_DEBUG=false
APP_URL="https://staging.example.com"
# Public origin of Monolith-Vue-Workers (OAuth return_to allowlist). Empty = Blade-only return.
SPA_URL=""

# --- Localization --------------------------------------------------------------
# Default locale for the app, fallback when a translation is missing, and locale
# used by Faker when seeding fake data.
APP_LOCALE="en"
APP_FALLBACK_LOCALE="en"
APP_FAKER_LOCALE="en_US"

# --- Maintenance mode ----------------------------------------------------------
# How Laravel stores maintenance-mode state. Use "file" for single-server setups;
# uncomment STORE for multi-server (requires cache/database).
APP_MAINTENANCE_DRIVER="file"
# APP_MAINTENANCE_STORE="database"

# --- PHP built-in server (php artisan serve) -----------------------------------
# Uncomment to set worker count when using the CLI dev server.
# PHP_CLI_SERVER_WORKERS=4

# --- Password hashing ----------------------------------------------------------
# bcrypt cost factor. Higher = slower but more resistant to brute-force.
BCRYPT_ROUNDS=12

# --- Web frontend layout -------------------------------------------------------
# Active Blade layout directory (resources/views/{WEB_LAYOUT}/). See docs/web-frontend.md
WEB_LAYOUT="adminlte4"

# --- JWT API authentication ----------------------------------------------------
# Stateless bearer tokens for the API guard. Secret signs HS256 tokens.
# JWT TTLs / refresh skew / blacklist grace: Settings → Platform (platform.jwt.*).
JWT_ALGO="HS256"
JWT_SECRET=""

# --- Auth defaults & two-factor authentication ---------------------------------
# Default API guard. Role / verification / 2FA: Settings → Platform.
AUTH_GUARD="api"

# --- Encryption (OCI KMS envelope) ---------------------------------------------
# Tier 2 envelope encryption for user secrets (not sessions).
# See docs/envelope-encryption.md

# · OCI connection
OCI_CONFIG_FILE="C:/laragon/www/monolith/.oci/config"
OCI_PROFILE="DEFAULT"
OCI_KMS_KEY_ID="ocid1.key.ap-singapore-1.xxxxxxxxx"
OCI_KMS_CRYPTO_ENDPOINT="https://xxxxxxxx-crypto.kms.ap-singapore-1.oraclecloud.com"
OCI_HTTP_TIMEOUT=15

# · Envelope policy
ENCRYPTION_KMS_ENABLED=true
ENCRYPTION_DECRYPTED_CACHE_MAX_TTL=0
ENCRYPTION_LOG_INVOICE_PAYLOAD_DECRYPTS=false
ENCRYPTION_AUDIT_DECRYPTS="cache_miss"
ENCRYPTION_BLIND_INDEX_PEPPER=""
ENCRYPTION_SESSION_ENABLED=false

# --- Logging -------------------------------------------------------------------
# Where and how application logs are written. LOG_LEVEL controls verbosity.
LOG_CHANNEL="stack"
LOG_STACK="single"
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL="info"

# Persistent DB error log (grouped). Independent of LOG_CHANNEL file logs.

# --- Database ------------------------------------------------------------------
# Primary persistence layer. This project expects MySQL in development/production.
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="monolith_staging"
DB_USERNAME="root"
DB_PASSWORD=""

# Block migrate:fresh / db:wipe on non-sqlite unless true (Monolith only).
# See docs/database-safety.md
ALLOW_DESTRUCTIVE_DB=false

# --- Session -------------------------------------------------------------------
# Server-side session storage for the web guard. Lifetime is in minutes.
# PRODUCTION: Set SESSION_SECURE_COOKIE=true untuk enforce HTTPS-only cookies
# PRODUCTION: Set SESSION_ENCRYPT=true untuk encrypt session data
SESSION_DRIVER="database"
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH="/"
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# --- Queue, cache & drivers ----------------------------------------------------
# Background jobs, default filesystem disk, and cache backend.
# BROADCAST_CONNECTION is configured in Notifications & realtime below.
# FILESYSTEM_DISK=s3 requires AWS_* env (not in templates — use FILE_HOSTING_S3_* for FH).
QUEUE_CONNECTION="redis"
DB_QUEUE_RETRY_AFTER=1800
FILESYSTEM_DISK="local"
CACHE_STORE="redis"
# CACHE_PREFIX=

# · Memcached (only if CACHE_STORE=memcached)
MEMCACHED_HOST="127.0.0.1"

# · Redis (cache / queue / session when driver=redis)
REDIS_CLIENT="phpredis"
REDIS_HOST="127.0.0.1"
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail -----------------------------------------------------------------------
# Outbound email transport. Use "log" in development to avoid sending real mail.
MAIL_MAILER="smtp"
MAIL_SCHEME=null
MAIL_HOST="smtp.example.com"
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
# From address/name: Settings → Platform (platform.mail.from_*).

# --- File Hosting --------------------------------------------------------------
# Multi-region S3 uploads. Docs: docs/domains/file-hosting/README.md

# · CE bucket (disk s3FileHostingCe) — Backblaze B2 / S3-compatible
FILE_HOSTING_S3_CE_REGION="auto"
FILE_HOSTING_S3_CE_BUCKET=""
FILE_HOSTING_S3_CE_KEY=""
FILE_HOSTING_S3_CE_SECRET=""
FILE_HOSTING_S3_CE_ENDPOINT=""
FILE_HOSTING_S3_CE_DOMAIN=""
# B2 and hybrid CF Worker forcePathStyle need path-style endpoints (default true).
FILE_HOSTING_S3_CE_USE_PATH_STYLE=true

# · Regions & key prefix (region key â†’ Laravel disk)
FILE_HOSTING_DISK="s3FileHostingCe"
FILE_HOSTING_DIRECTORY="file-hosting"
FILE_HOSTING_REGION_CE_DISK="s3FileHostingCe"
FILE_HOSTING_REGION_US_DISK=""
# Comma-separated region keys blocked for new uploads only (downloads still served).

# Optional dedicated credentials for US region disk (leave empty until provisioned).
# FILE_HOSTING_S3_US_BUCKET=
# FILE_HOSTING_S3_US_REGION=
# FILE_HOSTING_S3_US_KEY=
# FILE_HOSTING_S3_US_SECRET=
# FILE_HOSTING_S3_US_ENDPOINT=
# FILE_HOSTING_S3_US_DOMAIN=
# FILE_HOSTING_S3_US_USE_PATH_STYLE=true

# Upload tuning (chunk/multipart/concurrency/vault): Settings → File Hosting.

# · Gateway hybrid proxy (empty URL = browser-direct S3 presign)
# When set: upload PUT/UploadPart + download via Silverspoon Gateway.
# Token = Gateway S3_TARGETS.uploadToken (Bearer upload, HMAC download).
# Alias must match a key under Gateway S3_TARGETS.targets (e.g. sbs).
FILE_HOSTING_UPLOAD_PROXY_URL=""
FILE_HOSTING_UPLOAD_PROXY_TOKEN=""
FILE_HOSTING_UPLOAD_PROXY_TARGET_CE=""
FILE_HOSTING_UPLOAD_PROXY_TARGET_US=""

# --- hCaptcha ------------------------------------------------------------------
# Bot protection on public auth endpoints (defense-in-depth). Set enabled=true
# in production and provide keys from https://www.hcaptcha.com
HCAPTCHA_SECRET=""
HCAPTCHA_SITEKEY=""

# --- Notifications & realtime --------------------------------------------------
# Pusher / broadcast credentials only. Bell delivery mode: Settings → Platform.

BROADCAST_CONNECTION="pusher"
PUSHER_APP_ID=""
PUSHER_APP_KEY=""
PUSHER_APP_SECRET=""
PUSHER_PORT="443"
PUSHER_SCHEME="https"
PUSHER_APP_CLUSTER="auto"
PUSHER_HOST=""

# --- Discord OAuth (connected accounts / vTual claim verify) -------------------
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="${APP_URL}/apps/auth/discord/callback"

# --- Payments & checkout -------------------------------------------------------
# Registry: payment_gateways table. Config: config/payment.php
# Logical channels (QRIS/VA/e-wallet) in payment_channels + payment_channel_routes.
# Default buyer phone: Settings → Platform (platform.payment.default_buyer_phone).

# · FX rates (non-IDR catalog â†’ IDR via frankfurter.app, no API key)
FRANKFURTER_BASE_URL="https://api.frankfurter.app"
# Timeout / cache TTL: Settings → Platform (platform.frankfurter.*).

# · Midtrans (sandbox)
# MIDTRANS_NOTIFY_URL="https://api.example.com/api/v1/payments/providers/midtrans/webhook"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFY_URL=""

# · iPaymu (sandbox)
# IPAYMU_NOTIFY_URL="https://api.example.com/api/v1/payments/providers/ipaymu/webhook"
IPAYMU_VA_KEY=""
IPAYMU_API_KEY=""
IPAYMU_IS_PRODUCTION=false
IPAYMU_NOTIFY_URL=""

# --- Microstock AI (Open WebUI) ------------------------------------------------
# OpenAI-compatible chat-completions. Docs: docs/domains/microstock/README.md
# Endpoints + API keys + queue names stay env. Models/timeouts/variant/upstream: Settings → Microstock.

# · Vision model
MICROSTOCK_AI_VISION_ENDPOINT="https://ai-chat.spnd.uk/api/chat/completions"
MICROSTOCK_AI_VISION_API_KEY=""
# Model / free_model / timeout: Settings → Microstock (microstock.ai.vision.*).

# · Thinking model
MICROSTOCK_AI_THINKING_ENDPOINT="https://ai-chat.spnd.uk/api/chat/completions"
MICROSTOCK_AI_THINKING_API_KEY=""
# Model / free_model / timeout: Settings → Microstock (microstock.ai.thinking.*).

# Vision variant kind: Settings → Microstock (microstock.ai.vision_image.variant_kind).

# · Pipeline queues (run dedicated workers — see microstock README)
MICROSTOCK_AI_COLLECTION_VISION_QUEUE="microstock-collection-vision"
MICROSTOCK_AI_COLLECTION_THINKING_QUEUE="microstock-collection-thinking"
MICROSTOCK_AI_SOLO_QUEUE="microstock-solo"
MICROSTOCK_AI_COLLECTION_VISION_QUEUE_FREE="microstock-collection-vision-free"
MICROSTOCK_AI_COLLECTION_THINKING_QUEUE_FREE="microstock-collection-thinking-free"
MICROSTOCK_AI_SOLO_QUEUE_FREE="microstock-solo-free"

# Upstream window/budget/concurrency: Settings → Microstock (microstock.ai.upstream.*).

# · Daily free tier

# Inference provider slug: Settings → Microstock (microstock.ai.inference_provider_slug).

# · Inference pricing (core — see docs/domains/inference/README.md)
