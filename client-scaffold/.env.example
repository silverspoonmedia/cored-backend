APP_NAME="Client Project"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Core packages ──────────────────────────────────────────

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Guest locale cookie (the kernel's localization config owns the defaults)
LOCALE_COOKIE=locale
LOCALE_COOKIE_MINUTES=525600

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=client_project
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
# PRODUCTION: Set SESSION_SECURE_COOKIE=true to enforce HTTPS-only cookies.
# PRODUCTION: Set SESSION_ENCRYPT=true to encrypt session data.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Custom S3-compatible disk (e.g. Cloudflare R2) used by core attachment storage.
# Leave blank if you do not store files.
CUSTOM_S3_REGION="auto"
CUSTOM_S3_BUCKET_PUBLIC=
CUSTOM_S3_KEY=
CUSTOM_S3_SECRET=
CUSTOM_S3_ENDPOINT=
CUSTOM_S3_BUCKET_PUBLIC_DOMAIN=

JWT_SECRET=
JWT_TTL=60
JWT_REMEMBER_TTL=20160
JWT_REFRESH_TTL=20160

AUTH_GUARD=api
AUTH_DEFAULT_ROLE=User
AUTH_VERIFICATION_EXPIRE=60
TWO_FACTOR_WINDOW=1
TWO_FACTOR_ISSUER="${APP_NAME}"

BROADCAST_CONNECTION="pusher"
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_PORT="443"
PUSHER_SCHEME="https"
PUSHER_APP_CLUSTER="ap1"
# PUSHER_HOST=""

# Public origin of the SPA this project serves. Used for CORS, OAuth return
# links, mail links and hosted payment returns. Empty keeps signed API URLs.
SPA_URL=

# Discord OAuth (Identity). The callback defaults to APP_URL/apps/auth/discord/callback.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=

# hCaptcha on public forms (kernel config owns the defaults).
HCAPTCHA_SECRET=
HCAPTCHA_SITEKEY=

# Encryption at rest (Tier C). Empty pepper keeps blind indexes deterministic per install.
ENCRYPTION_BLIND_INDEX_PEPPER=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

# Client-specific environment variables go below.
