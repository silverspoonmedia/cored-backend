{
    "name": "silverspoonmedia/audit",
    "description": "Silverspoon core domain package: forensic activity trail + grouped persistent error log.",
    "type": "library",
    "license": "proprietary",
    "version": "1.1.0",
    "homepage": "https://github.com/silverspoonmedia/audit",
    "support": {
        "source": "https://github.com/silverspoonmedia/audit"
    },
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "silverspoonmedia/platform": "^1.1",
        "spatie/laravel-activitylog": "^5.0",
        "symfony/console": "^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\Domain\\ActivityLog\\": "src/ActivityLog/",
            "App\\Domain\\ErrorLog\\": "src/ErrorLog/",
            "App\\Domain\\ActivityLog\\Tests\\": "tests/ActivityLog/",
            "App\\Domain\\ErrorLog\\Tests\\": "tests/ErrorLog/"
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "App\\Domain\\ActivityLog\\AuditServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
