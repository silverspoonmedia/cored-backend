{
    "name": "silverspoonmedia/ai",
    "description": "Silverspoon core domain package: model catalog and per-provider rates (Inference) and the endpoint/key connections that reach them (Ai).",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.0",
    "homepage": "https://github.com/silverspoonmedia/ai",
    "support": {
        "source": "https://github.com/silverspoonmedia/ai"
    },
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Domain\\Ai\\": "src/Ai/",
            "App\\Domain\\Inference\\": "src/Inference/",
            "App\\Domain\\Ai\\Tests\\": "tests/Ai/",
            "App\\Domain\\Inference\\Tests\\": "tests/Inference/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "App\\Domain\\Ai\\AiServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
