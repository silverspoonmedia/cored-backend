{
    "name": "silverspoonmedia/cored-backend",
    "type": "project",
    "description": "Cored — a product-free host for the Silverspoon core packages.",
    "keywords": ["laravel", "laravel-framework", "silverspoon", "boilerplate"],
    "license": "proprietary",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/silverspoonmedia/platform.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/silverspoonmedia/navigation.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/silverspoonmedia/notification.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/silverspoonmedia/audit.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/silverspoonmedia/billing.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/silverspoonmedia/ai.git"
        }
    ],
    "require": {
        "php": "^8.4",
        "chillerlan/php-qrcode": "^4.4",
        "intervention/image": "^4.2",
        "ipaymu/ipaymu-php-api": "^3.0",
        "laravel-lang/common": "^6.8",
        "laravel/framework": "^13.8",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "3.*",
        "midtrans/midtrans-php": "^2.6",
        "php-open-source-saver/jwt-auth": "^2.9",
        "phpseclib/phpseclib": "^3.0.50",
        "pragmarx/google2fa-laravel": "^3.0",
        "pusher/pusher-php-server": "^7.2",
        "silverspoonmedia/ai": "^1.1",
        "silverspoonmedia/audit": "^1.1",
        "silverspoonmedia/billing": "^1.1",
        "silverspoonmedia/navigation": "^1.1",
        "silverspoonmedia/notification": "^1.1",
        "silverspoonmedia/platform": "^1.1",
        "spatie/laravel-permission": "^8.0",
        "spatie/laravel-translatable": "^6.14",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Support\\": "app/Support/",
            "App\\Console\\": "app/Console/",
            "App\\Http\\": "app/Http/",
            "App\\Repositories\\": "app/Repositories/",
            "App\\Domain\\Identity\\": "app/Domain/Identity/",
            "App\\Domain\\ActivityLog\\": "app/Domain/ActivityLog/",
            "App\\Domain\\Ai\\": "app/Domain/Ai/",
            "App\\Domain\\Currency\\": "app/Domain/Currency/",
            "App\\Domain\\ErrorLog\\": "app/Domain/ErrorLog/",
            "App\\Domain\\Inference\\": "app/Domain/Inference/",
            "App\\Domain\\Navigation\\": "app/Domain/Navigation/",
            "App\\Domain\\Notification\\": "app/Domain/Notification/",
            "App\\Domain\\PaymentGateway\\": "app/Domain/PaymentGateway/",
            "App\\Domain\\Service\\": "app/Domain/Service/",
            "App\\Traits\\": "app/Traits/",
            "App\\Rules\\": "app/Rules/",
            "App\\Exceptions\\": "app/Exceptions/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"if (!file_exists('.env')) { passthru(PHP_BINARY.' artisan env:install local'); }\"",
            "@php artisan migrate --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" --names=server,queue,logs --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "check": [
            "@check:style",
            "@check:types",
            "@test"
        ],
        "check:style": [
            "pint --test"
        ],
        "check:types": [
            "@php artisan config:clear --ansi",
            "phpstan analyse --no-progress --memory-limit=1G"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan lang:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"if (!file_exists('.env')) { passthru(PHP_BINARY.' artisan env:install local'); }\""
        ],
        "post-create-project-cmd": [
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
