*.log
.DS_Store
# Every real env file, at any depth. Only the committed `.example` templates
# stay tracked — `.env.pre-archivd-backup` slipped through the old explicit
# list and carried live credentials; the blanket pattern closes that class.
.env
.env.*
!.env.example
!.env.local.example
!.env.production.example
!.env.staging.example
# Local seed data (real AI endpoint + API key) — template `.example.php` is tracked.
/database/seeders/data/*.local.php
.phpactor.json
.phpunit.result.cache
/.codex
# Cursor local state; committed project rules live in .cursor/rules/
/.cursor/*
!/.cursor/rules/
!/.cursor/rules/**
/.idea
/.nova
/.oci
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
/monolith

