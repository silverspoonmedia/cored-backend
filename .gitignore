*.log
.DS_Store
# Every real env file, at any depth. Only the committed `.example` templates
# stay tracked — `.env.pre-archivd-backup` slipped through the old explicit
# list and carried live credentials; the blanket pattern closes that class.
.env
.env.*
!.env.example
!.env.local.example
!.env.production.example
!.env.staging.example
# Local seed data (real AI endpoint + API key) — template `.example.php` is tracked.
/database/seeders/data/*.local.php
.phpactor.json
.phpunit.result.cache
/.codex
# Cursor local state; committed project rules live in .cursor/rules/ and
# committed project skills live in .cursor/skills/ (e.g. domain-remove).
/.cursor/*
!/.cursor/rules/
!/.cursor/rules/**
!/.cursor/skills/
!/.cursor/skills/**
/.idea
/.nova
/.oci
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
# Composer path packages (packages/*) are source, not dependencies: their own
# vendor/ and lock file never ship. The host lock file pins them.
/packages/*/vendor
/packages/*/composer.lock
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
/monolith

# i18n curation scratch (pair dumps, apply batches)
/.tmp-i18n/

# PHPStan result cache
/.phpstan.cache/

# Locale coverage audit output. Generated on demand by
# `php scripts/backend-locale-audit.php backend-locale-report.json` and read by
# `scripts/locale-report-query.php`; never a source file, never committed.
/backend-locale-report.json

