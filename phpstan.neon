includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5

    paths:
        - app
        # A consumer install carries the six core packages under `vendor/`; the
        # monolith carries them under `packages/`. PHPStan fails on a configured
        # path that does not exist, so this gate names the shape this repo ships —
        # the fork's own `phpstan.neon` is the fork's contract, not a copy.
        - vendor/silverspoonmedia/ai/src
        - vendor/silverspoonmedia/audit/src
        - vendor/silverspoonmedia/billing/src
        - vendor/silverspoonmedia/navigation/src
        - vendor/silverspoonmedia/notification/src
        - vendor/silverspoonmedia/platform/src
        - database
        - routes
        - config

    # Without every migration path Larastan cannot read the model columns, and every
    # `$model->column` in a package reports `property.notFound` — 626 of the findings
    # on the monolith's first run were this, not real defects.
    databaseMigrationsPath:
        - database/migrations
        - vendor/silverspoonmedia/ai/database/migrations
        - vendor/silverspoonmedia/audit/database/migrations
        - vendor/silverspoonmedia/billing/database/migrations
        - vendor/silverspoonmedia/navigation/database/migrations
        - vendor/silverspoonmedia/notification/database/migrations
        - vendor/silverspoonmedia/platform/database/migrations

    # `tests/**` is deliberately outside the analysed surface. A suite is a
    # scaffold, not shipped code: its helpers lean on `$this->get()`, factories and
    # `assertSee()` magic that produce findings PHPStan cannot make actionable
    # without annotating every test. The tests are already the gate for that code.

    # PHPDoc here documents intent (`array{...}` on a payload that arrives over
    # HTTP), not a proven type. Treating it as certain turns every defensive `??`
    # and `is_array()` into a false positive.
    treatPhpDocTypesAsCertain: false

    # Larastan reads cast types from the return type of `casts()`. Every model
    # here uses the method form, not the `$casts` property, so with the default
    # (`false`) every enum-cast column reads as the migration's `string` and
    # `$model->status->isX()` reports `method.nonObject`. With it on, the cast is
    # what the model actually returns at runtime.
    parseModelCastsMethod: true

    tmpDir: .phpstan.cache

    ignoreErrors:
        # The kernel's testing concerns are used only by the package suites, which
        # run from the mirrors against their own Testbench harness — `tests/**` and
        # `app/**` never reference them, so PHPStan sees zero uses. Exercised by
        # every package suite; not dead code.
        - identifier: trait.unused
          paths:
              - vendor/silverspoonmedia/platform/src/Support/Testing/Concerns/*
        # `SerializesDirectUploadSession` is a product-domain seam: the monolith's
        # Archivd upload controller is its only user, and this fork ships no product
        # domain. The trait stays in the kernel package so a fork that adds an
        # upload surface keeps the same serialisation contract.
        -
            message: '#Trait App\\Support\\Storage\\SerializesDirectUploadSession is used zero times#'
        # `JsonResource::$this->field` is `__get` on the wrapped model, not a
        # property of the resource class. PHPStan cannot see the model's columns
        # through it, so every resource field reports `property.notFound`.
        - identifier: property.notFound
          paths:
              - */Http/Resources/*
