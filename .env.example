# =============================================================================
# Master environment variable catalog for Monolith.
# Documents every variable with block comments. Do NOT copy this file directly.
# Use a profile template instead:
#   php artisan env:install local|staging|production
# Keep all profile templates (.env.*.example) in sync when adding or removing keys.
# See docs/environment.md
# =============================================================================

# --- Application ---------------------------------------------------------------
# Core Laravel identity: app name, environment, encryption keys, debug mode, and
# public base URL. APP_KEY is the active encryption key; APP_PREVIOUS_KEYS holds
# comma-separated retired keys after `php artisan key:generate --force` (Laravel
# key rotation — see config/app.php previous_keys). Empty in fresh templates.
APP_NAME="Laravel"
APP_ENV="local"
APP_KEY=""
APP_PREVIOUS_KEYS=""
APP_DEBUG=true
APP_URL="http://localhost"

# --- Localization --------------------------------------------------------------
# Default locale for the app, fallback when a translation is missing, and locale
# used by Faker when seeding fake data.
APP_LOCALE="en"
APP_FALLBACK_LOCALE="en"
APP_FAKER_LOCALE="en_US"

# --- Maintenance mode ----------------------------------------------------------
# How Laravel stores maintenance-mode state. Use "file" for single-server setups;
# uncomment STORE for multi-server (requires cache/database).
APP_MAINTENANCE_DRIVER="file"
# APP_MAINTENANCE_STORE="database"

# --- PHP built-in server (php artisan serve) -----------------------------------
# Uncomment to set worker count when using the CLI dev server.
# PHP_CLI_SERVER_WORKERS=4

# --- Password hashing ----------------------------------------------------------
# bcrypt cost factor. Higher = slower but more resistant to brute-force.
BCRYPT_ROUNDS=12

# --- Web frontend layout -------------------------------------------------------
# Active Blade layout directory (resources/views/{WEB_LAYOUT}/). See docs/web-frontend.md
WEB_LAYOUT="adminlte4"

# --- Guest locale cookie -------------------------------------------------------
# Persists language choice for unauthenticated visitors. See docs/localization.md
LOCALE_COOKIE="locale"
LOCALE_COOKIE_MINUTES=525600

# --- JWT API authentication ----------------------------------------------------
# Stateless bearer tokens for the API guard. Secret signs HS256 tokens; TTL values
# are in minutes. See docs/jwt-authentication.md
JWT_ALGO="HS256"
JWT_SECRET=""
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_REMEMBER_TTL=20160
# Minutes before access exp when Blade silently refreshes auth_token (RefreshJwtCookie).
JWT_REFRESH_SKEW=5
# Seconds the predecessor JWT stays valid after refresh (parallel tabs / ApiClient).
JWT_BLACKLIST_GRACE_PERIOD=30

# --- Auth defaults & two-factor authentication ---------------------------------
# Default guard, role assigned on registration, email-verification link expiry
# (minutes), and TOTP settings for 2FA (window = allowed clock drift in steps).
AUTH_GUARD="api"
AUTH_DEFAULT_ROLE="User"
AUTH_VERIFICATION_EXPIRE=60
TWO_FACTOR_WINDOW=1
TWO_FACTOR_ISSUER="${APP_NAME}"

# --- Encryption (OCI KMS envelope) ---------------------------------------------
# Tier 2 envelope encryption for user secrets (not sessions).
# See docs/envelope-encryption.md

# · OCI connection
OCI_CONFIG_FILE="C:/laragon/www/monolith/.oci/config"
OCI_PROFILE="DEFAULT"
OCI_KMS_KEY_ID="ocid1.key.ap-singapore-1.xxxxxxxxx"
OCI_KMS_CRYPTO_ENDPOINT="https://xxxxxxxx-crypto.kms.ap-singapore-1.oraclecloud.com"
OCI_HTTP_TIMEOUT=15

# · Envelope policy
ENCRYPTION_KMS_ENABLED=true
ENCRYPTION_DECRYPTED_CACHE_MAX_TTL=86400
ENCRYPTION_LOG_INVOICE_PAYLOAD_DECRYPTS=false
ENCRYPTION_AUDIT_DECRYPTS="cache_miss"
ENCRYPTION_BLIND_INDEX_PEPPER=""
ENCRYPTION_SESSION_ENABLED=false

# --- Logging -------------------------------------------------------------------
# Where and how application logs are written. LOG_LEVEL controls verbosity.
LOG_CHANNEL="stack"
LOG_STACK="single"
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL="debug"

# Persistent DB error log (grouped). Independent of LOG_CHANNEL file logs.
ERRORLOG_ENABLED=true
ERRORLOG_CLEAN_AFTER_DAYS=90

# --- Database ------------------------------------------------------------------
# Primary persistence layer. This project expects MySQL in development/production.
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="monolith"
DB_USERNAME="root"
DB_PASSWORD=""

# Block migrate:fresh / db:wipe on MySQL (and other non-sqlite) in local unless true.
# See docs/database-safety.md
ALLOW_DESTRUCTIVE_DB=false

# --- Session -------------------------------------------------------------------
# Server-side session storage for the web guard. Lifetime is in minutes.
# PRODUCTION: Set SESSION_SECURE_COOKIE=true untuk enforce HTTPS-only cookies
# PRODUCTION: Set SESSION_ENCRYPT=true untuk encrypt session data
SESSION_DRIVER="database"
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH="/"
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# --- Queue, cache & drivers ----------------------------------------------------
# Background jobs, default filesystem disk, and cache backend.
# BROADCAST_CONNECTION is configured in Notifications & realtime below.
# FILESYSTEM_DISK=s3 requires AWS_* env (not in templates — use FILE_HOSTING_S3_* for FH).
QUEUE_CONNECTION="database"
DB_QUEUE_RETRY_AFTER=1800
FILESYSTEM_DISK="local"
CACHE_STORE="database"
# CACHE_PREFIX=

# · Memcached (only if CACHE_STORE=memcached)
MEMCACHED_HOST="127.0.0.1"

# · Redis (cache / queue / session when driver=redis)
REDIS_CLIENT="phpredis"
REDIS_HOST="127.0.0.1"
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail -----------------------------------------------------------------------
# Outbound email transport. Use "log" in development to avoid sending real mail.
MAIL_MAILER="log"
MAIL_SCHEME=null
MAIL_HOST="127.0.0.1"
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- File Hosting --------------------------------------------------------------
# Multi-region S3 uploads. Docs: docs/domains/file-hosting/README.md

# · CE bucket (disk s3FileHostingCe) — Backblaze B2 / S3-compatible
FILE_HOSTING_S3_CE_REGION="auto"
FILE_HOSTING_S3_CE_BUCKET=""
FILE_HOSTING_S3_CE_KEY=""
FILE_HOSTING_S3_CE_SECRET=""
FILE_HOSTING_S3_CE_ENDPOINT=""
FILE_HOSTING_S3_CE_DOMAIN=""
# B2 and hybrid CF Worker forcePathStyle need path-style endpoints (default true).
FILE_HOSTING_S3_CE_USE_PATH_STYLE=true

# · Regions & key prefix (region key → Laravel disk)
FILE_HOSTING_DISK="s3FileHostingCe"
FILE_HOSTING_DIRECTORY="file-hosting"
FILE_HOSTING_REGION_CE_DISK="s3FileHostingCe"
FILE_HOSTING_REGION_US_DISK=""
# Comma-separated region keys blocked for new uploads only (downloads still served).
FILE_HOSTING_DISABLED_REGIONS=""

# Optional dedicated credentials for US region disk (leave empty until provisioned).
# FILE_HOSTING_S3_US_BUCKET=
# FILE_HOSTING_S3_US_REGION=
# FILE_HOSTING_S3_US_KEY=
# FILE_HOSTING_S3_US_SECRET=
# FILE_HOSTING_S3_US_ENDPOINT=
# FILE_HOSTING_S3_US_DOMAIN=
# FILE_HOSTING_S3_US_USE_PATH_STYLE=true

# · Upload tuning (bytes; Worker request body cap 100 MB — use 10–50 MB parts)
# FILE_HOSTING_CHUNK_SIZE=26214400
# FILE_HOSTING_MULTIPART_THRESHOLD=26214400
# FILE_HOSTING_MAX_CONCURRENT_PARTS=3

# · Gateway hybrid proxy (empty URL = browser-direct S3 presign)
# When set: upload PUT/UploadPart + download via Silverspoon Gateway.
# Token = Gateway S3_TARGETS.uploadToken (Bearer upload, HMAC download).
# Alias must match a key under Gateway S3_TARGETS.targets (e.g. sbs).
# FILE_HOSTING_UPLOAD_PROXY_URL="https://gateway.silverspoon.me"
# FILE_HOSTING_UPLOAD_PROXY_TOKEN="same-as-gateway-S3_TARGETS-uploadToken"
# FILE_HOSTING_UPLOAD_PROXY_TARGET_CE="sbs"
# FILE_HOSTING_UPLOAD_PROXY_TARGET_US=
# FILE_HOSTING_DOWNLOAD_VAULT_ENABLED=true

# --- hCaptcha ------------------------------------------------------------------
# Bot protection on public auth endpoints (defense-in-depth). Set enabled=true
# in production and provide keys from https://www.hcaptcha.com
HCAPTCHA_ENABLED=false
HCAPTCHA_SECRET=""
HCAPTCHA_SITEKEY=""

# --- Notifications & realtime --------------------------------------------------
# Bell badge delivery: polling hits the API on an interval; realtime pushes via
# WebSockets and requires valid PUSHER_* below. See docs/notifications.md
APP_NOTIFICATION_TYPE="polling" # polling | realtime
APP_NOTIFICATION_POLLING_INTERVAL=60
# APP_LIVE_SYNC_TYPE="realtime"
# APP_LIVE_SYNC_POLLING_INTERVAL=30
# APP_LIVE_SYNC_VERSION_TTL=86400

BROADCAST_CONNECTION="pusher"
PUSHER_APP_ID=""
PUSHER_APP_KEY=""
PUSHER_APP_SECRET=""
PUSHER_PORT="443"
PUSHER_SCHEME="https"
PUSHER_APP_CLUSTER="auto"
PUSHER_HOST=""
# leave empty to use Pusher-hosted WebSocket endpoint

# · Vite (exposes Pusher to browser)
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

# --- Payments & checkout -------------------------------------------------------
# Registry: payment_gateways table. Config: config/payment.php
# Logical channels (QRIS/VA/e-wallet) in payment_channels + payment_channel_routes.
PAYMENT_PREFER_CHANNEL_CHECKOUT=true
# Placeholder until User profile stores phone (iPaymu requires buyer phone)
PAYMENT_DEFAULT_BUYER_PHONE=081000000000

# · FX rates (non-IDR catalog → IDR via frankfurter.app, no API key)
FRANKFURTER_BASE_URL="https://api.frankfurter.app"
FRANKFURTER_TIMEOUT=10
FRANKFURTER_CACHE_TTL=3600

# · Midtrans (sandbox)
# MIDTRANS_NOTIFY_URL="https://api.example.com/api/v1/payments/providers/midtrans/webhook"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFY_URL=""

# · iPaymu (sandbox)
# IPAYMU_NOTIFY_URL="https://api.example.com/api/v1/payments/providers/ipaymu/webhook"
IPAYMU_VA_KEY=""
IPAYMU_API_KEY=""
IPAYMU_IS_PRODUCTION=false
IPAYMU_NOTIFY_URL=""

# --- Microstock AI (Open WebUI) ------------------------------------------------
# OpenAI-compatible chat-completions. Docs: docs/domains/microstock/README.md
# Models: internal.vision, internal.thinking — JWT Bearer via MICROSTOCK_AI_*_API_KEY

# · Vision model
MICROSTOCK_AI_VISION_ENDPOINT="https://ai-chat.spnd.uk/api/chat/completions"
MICROSTOCK_AI_VISION_MODEL="internal.vision"
MICROSTOCK_AI_VISION_API_KEY=""
MICROSTOCK_AI_VISION_TIMEOUT=1500

# · Thinking model
MICROSTOCK_AI_THINKING_ENDPOINT="https://ai-chat.spnd.uk/api/chat/completions"
MICROSTOCK_AI_THINKING_MODEL="internal.thinking"
MICROSTOCK_AI_THINKING_API_KEY=""
MICROSTOCK_AI_THINKING_TIMEOUT=1500

# · Job timing & limits (grace must stay below DB_QUEUE_RETRY_AFTER)
MICROSTOCK_AI_PHASE_NORMAL=600
MICROSTOCK_AI_PHASE_GRACE=1500
MICROSTOCK_AI_VISION_GRACE_AFTER=600
MICROSTOCK_AI_THINKING_GRACE_AFTER=1800
MICROSTOCK_AI_THINKING_BACKLOG_AFTER=120
MICROSTOCK_AI_IMAGE_MAX_PX=1024
MICROSTOCK_AI_IMAGE_JPEG_QUALITY=80
MICROSTOCK_AI_MAX_REQUEST_IMAGE_BYTES=200000
MICROSTOCK_AI_HTTP_RETRIES=0
MICROSTOCK_AI_THINKING_VISUAL_ATTEMPTS=2
MICROSTOCK_AI_BATCH_CHUNK=10
MICROSTOCK_AI_BATCH_MIN_FILES=4
MICROSTOCK_AI_VISION_IMAGE_DELIVERY=url
MICROSTOCK_AI_VISION_VARIANT=ai_1024
MICROSTOCK_AI_VISION_URL_TTL=30

# · Pipeline queues (run dedicated workers — see microstock README)
MICROSTOCK_AI_COLLECTION_VISION_QUEUE=microstock-collection-vision
MICROSTOCK_AI_COLLECTION_THINKING_QUEUE=microstock-collection-thinking
MICROSTOCK_AI_SOLO_QUEUE=microstock-solo
MICROSTOCK_AI_COLLECTION_VISION_QUEUE_FREE=microstock-collection-vision-free
MICROSTOCK_AI_COLLECTION_THINKING_QUEUE_FREE=microstock-collection-thinking-free
MICROSTOCK_AI_SOLO_QUEUE_FREE=microstock-solo-free

# · Daily free tier
MICROSTOCK_DAILY_FREE_ENABLED=false
MICROSTOCK_DAILY_FREE_LIMIT=5
MICROSTOCK_DAILY_FREE_TIMEZONE=UTC

# · Billing (prepaid credits)
MICROSTOCK_AI_BILLING_MARKUP=1.35
MICROSTOCK_AI_BILLING_ESTIMATE_PER_ASSET=150000
MICROSTOCK_AI_BILLING_ESTIMATE_FACTOR=1.5
