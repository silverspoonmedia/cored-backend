# =============================================================================
# Master environment variable catalog for Monolith.
# Documents every variable with block comments. Do NOT copy this file directly.
# Use a profile template instead:
#   php artisan env:install local|staging|production
# Keep all profile templates (.env.*.example) in sync when adding or removing keys.
# See docs/environment.md
# =============================================================================

# --- Application ---------------------------------------------------------------
# Core Laravel identity: app name, environment, encryption keys, debug mode, and
# public base URL. APP_KEY is the active encryption key; APP_PREVIOUS_KEYS holds
# comma-separated retired keys after `php artisan key:generate --force` (Laravel
# key rotation — see config/app.php previous_keys). Empty in fresh templates.
APP_NAME="Laravel"
APP_ENV="local"
APP_KEY=""
APP_PREVIOUS_KEYS=""
APP_DEBUG=true
APP_URL="http://localhost"

# --- Localization --------------------------------------------------------------
# Default locale for the app, fallback when a translation is missing, and locale
# used by Faker when seeding fake data.
APP_LOCALE="en"
APP_FALLBACK_LOCALE="en"
APP_FAKER_LOCALE="en_US"

# --- Maintenance mode ----------------------------------------------------------
# How Laravel stores maintenance-mode state. Use "file" for single-server setups;
# uncomment STORE for multi-server (requires cache/database).
APP_MAINTENANCE_DRIVER="file"
# APP_MAINTENANCE_STORE="database"

# --- PHP built-in server (php artisan serve) -----------------------------------
# Uncomment to set worker count when using the CLI dev server.
# PHP_CLI_SERVER_WORKERS=4

# --- Password hashing ----------------------------------------------------------
# bcrypt cost factor. Higher = slower but more resistant to brute-force.
BCRYPT_ROUNDS=12

# KEK & DEK
OCI_CONFIG_FILE="C:/laragon/www/monolith/.oci/config"
OCI_PROFILE="DEFAULT"

OCI_KMS_KEY_ID="ocid1.key.ap-singapore-1.xxxxxxxxx"
OCI_KMS_CRYPTO_ENDPOINT="https://xxxxxxxx-crypto.kms.ap-singapore-1.oraclecloud.com"

OCI_HTTP_TIMEOUT=15

# --- Envelope encryption (OCI KMS KEK/DEK) ---------------------------------------
# See docs/envelope-encryption.md — Tier 2 OCI KMS envelope (user secrets, not sessions)
ENCRYPTION_KMS_ENABLED=true
ENCRYPTION_DECRYPTED_CACHE_MAX_TTL=86400
ENCRYPTION_LOG_INVOICE_PAYLOAD_DECRYPTS=false
ENCRYPTION_AUDIT_DECRYPTS="cache_miss"
ENCRYPTION_BLIND_INDEX_PEPPER=""
ENCRYPTION_SESSION_ENABLED=false

# --- Web frontend layout -------------------------------------------------------
# Active Blade layout directory (resources/views/{WEB_LAYOUT}/). See docs/web-frontend.md
WEB_LAYOUT="adminlte4"

# --- Guest locale cookie -------------------------------------------------------
# Persists language choice for unauthenticated visitors. See docs/localization.md
LOCALE_COOKIE="locale"
LOCALE_COOKIE_MINUTES=525600

# --- JWT API authentication ----------------------------------------------------
# Stateless bearer tokens for the API guard. Secret signs HS256 tokens; TTL values
# are in minutes. See docs/jwt-authentication.md
JWT_ALGO="HS256"
JWT_SECRET=""
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_REMEMBER_TTL=20160

# --- Auth defaults & two-factor authentication ---------------------------------
# Default guard, role assigned on registration, email-verification link expiry
# (minutes), and TOTP settings for 2FA (window = allowed clock drift in steps).
AUTH_GUARD="api"
AUTH_DEFAULT_ROLE="User"
AUTH_VERIFICATION_EXPIRE=60
TWO_FACTOR_WINDOW=1
TWO_FACTOR_ISSUER="${APP_NAME}"

# --- Logging -------------------------------------------------------------------
# Where and how application logs are written. LOG_LEVEL controls verbosity.
LOG_CHANNEL="stack"
LOG_STACK="single"
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL="debug"

# Persistent DB error log (grouped). Independent of LOG_CHANNEL file logs.
ERRORLOG_ENABLED=true
ERRORLOG_CLEAN_AFTER_DAYS=90

# --- Database ------------------------------------------------------------------
# Primary persistence layer. This project expects MySQL in development/production.
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="monolith"
DB_USERNAME="root"
DB_PASSWORD=""

# Block migrate:fresh / db:wipe on MySQL (and other non-sqlite) in local unless true.
# See docs/database-safety.md
ALLOW_DESTRUCTIVE_DB=false

# --- Session -------------------------------------------------------------------
# Server-side session storage for the web guard. Lifetime is in minutes.
# PRODUCTION: Set SESSION_SECURE_COOKIE=true untuk enforce HTTPS-only cookies
# PRODUCTION: Set SESSION_ENCRYPT=true untuk encrypt session data
SESSION_DRIVER="database"
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH="/"
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# --- Queue, filesystem & default broadcasting --------------------------------
# Background jobs, default file storage disk, and fallback broadcast driver.
# BROADCAST_CONNECTION below is overridden again in the Notifications block when
# APP_NOTIFICATION_TYPE=realtime.
BROADCAST_CONNECTION="log"
FILESYSTEM_DISK="local"
QUEUE_CONNECTION="database"

# --- Cache ---------------------------------------------------------------------
# Application cache backend. Optional prefix avoids key collisions on shared Redis.
CACHE_STORE="database"
# CACHE_PREFIX=

# --- Memcached -----------------------------------------------------------------
# Connection settings when CACHE_STORE=memcached.
MEMCACHED_HOST="127.0.0.1"

# --- Redis ---------------------------------------------------------------------
# Connection for cache, queue, or session when those drivers are set to redis.
REDIS_CLIENT="phpredis"
REDIS_HOST="127.0.0.1"
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail -----------------------------------------------------------------------
# Outbound email transport. Use "log" in development to avoid sending real mail.
MAIL_MAILER="log"
MAIL_SCHEME=null
MAIL_HOST="127.0.0.1"
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS S3 (Laravel default disk) ---------------------------------------------
# Standard Laravel S3 disk credentials. Used when FILESYSTEM_DISK=s3.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"
AWS_BUCKET=""
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Custom S3-compatible storage (e.g. Cloudflare R2) -------------------------
# Dedicated public disk "s3Custom" for File Hosting (and other S3-compatible storage).
# Leave blank if unused. See config/filesystems.php and config/file-hosting.php
CUSTOM_S3_REGION="auto"
CUSTOM_S3_BUCKET_PUBLIC=""
CUSTOM_S3_KEY=""
CUSTOM_S3_SECRET=""
CUSTOM_S3_ENDPOINT=""
CUSTOM_S3_BUCKET_PUBLIC_DOMAIN=""
# B2 and hybrid CF Worker forcePathStyle need path-style endpoints (default true).
CUSTOM_S3_USE_PATH_STYLE=true

# S3-compatible disk for EU region (optional; used when FILE_HOSTING_REGION_EU_DISK=s3Customeu)
CUSTOM_S3_BUCKET_PUBLIC_EU=""
CUSTOM_S3_ENDPOINT_EU=""

# --- File Hosting: multi-region upload selector ---------------------------------
# Region key → disk name. Only regions with a non-empty disk appear in the
# upload dropdown. Add a disk in config/filesystems.php, then map it here.
FILE_HOSTING_DISK="s3Custom"
FILE_HOSTING_REGION_SEA_DISK="s3Custom"
FILE_HOSTING_REGION_US_DISK=""
FILE_HOSTING_REGION_EU_DISK="s3Customeu"
# Comma-separated region keys blocked for new uploads only (downloads still served).
FILE_HOSTING_DISABLED_REGIONS=""

# Part size defaults: 10 MB (aligned with CF Worker Free body limits).
# FILE_HOSTING_CHUNK_SIZE=10485760
# FILE_HOSTING_MULTIPART_THRESHOLD=10485760

# Optional hybrid CF Worker byte path (empty URL = browser-direct S3 presign).
# When URL is set, token + disk→alias map are required (fail closed).
# Worker name: cf-workers-s3-proxy. Example production origin: https://s3.silverspoon.me
# Alias must match a key under Worker S3_TARGETS.targets (e.g. sbs).
# FILE_HOSTING_UPLOAD_PROXY_URL="https://s3.silverspoon.me"
# FILE_HOSTING_UPLOAD_PROXY_TOKEN="same-as-worker-S3_TARGETS-uploadToken"
# FILE_HOSTING_UPLOAD_PROXY_TARGET_S3CUSTOM="sbs"
# FILE_HOSTING_UPLOAD_PROXY_TARGET_S3CUSTOMEU="sbs-eu"

# --- hCaptcha ------------------------------------------------------------------
# Bot protection on public auth endpoints (defense-in-depth). Set enabled=true
# in production and provide keys from https://www.hcaptcha.com
HCAPTCHA_ENABLED=false
HCAPTCHA_SECRET=""
HCAPTCHA_SITEKEY=""

# --- Activity notifications & realtime broadcasting -----------------------------
# Bell badge delivery: "polling" hits the API on an interval; "realtime" pushes
# via WebSockets and requires valid PUSHER_* below. See docs/notifications.md
APP_NOTIFICATION_TYPE="polling" # polling | realtime

# Polling badge refresh interval in seconds (only used when type=polling).
APP_NOTIFICATION_POLLING_INTERVAL=60

# Overrides BROADCAST_CONNECTION from the infrastructure block when using realtime.
BROADCAST_CONNECTION="pusher"
PUSHER_APP_ID=""
PUSHER_APP_KEY=""
PUSHER_APP_SECRET=""
PUSHER_PORT="443"
PUSHER_SCHEME="https"
PUSHER_APP_CLUSTER="auto"
PUSHER_HOST=""
# PUSHER_HOST=""  # leave empty to use Pusher-hosted WebSocket endpoint

# --- Payment gateways -----------------------------------------------------------
# Credentials in config/payment.php; registry in payment_gateways table.
# Logical channels (QRIS/VA/e-wallet) in payment_channels + payment_channel_routes (PaymentChannelSeeder).
PAYMENT_PREFER_CHANNEL_CHECKOUT=true
# Placeholder until User profile stores phone (iPaymu requires buyer phone)
PAYMENT_DEFAULT_BUYER_PHONE=081000000000

# --- Frankfurter FX (Service checkout multi-currency → IDR) -------------------
# ECB rates via frankfurter.app — no API key. Used when catalog prices are not IDR.
FRANKFURTER_BASE_URL="https://api.frankfurter.app"
FRANKFURTER_TIMEOUT=10
FRANKFURTER_CACHE_TTL=3600

# --- PG: Midtrans ---------------------------------------------------------------
# Webhook URL must use your public Monolith Gateway host; do not use https://api.example.com literally.
# MIDTRANS_NOTIFY_URL="https://api.example.com/api/v1/payments/providers/midtrans/webhook"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFY_URL=""

# --- PG: iPaymu -----------------------------------------------------------------
# Webhook URL must use your public Monolith Gateway host; do not use https://api.example.com literally.
# IPAYMU_NOTIFY_URL="https://api.example.com/api/v1/payments/providers/ipaymu/webhook"
IPAYMU_VA_KEY=""
IPAYMU_API_KEY=""
IPAYMU_IS_PRODUCTION=false
IPAYMU_NOTIFY_URL=""

# --- Public gateway perimeter --------------------------------------------------
# When GATEWAY_ENFORCE=true, API routes require X-Gateway-Secret or an IP in
# GATEWAY_ALLOWED_IPS. Disable locally; enable in production behind monolith-gateway.
GATEWAY_ENFORCE=false
GATEWAY_SECRET=""
GATEWAY_ALLOWED_IPS=""

# --- Vite frontend (exposed to browser) ----------------------------------------
# Variables prefixed VITE_ are embedded in the JS bundle at build time. Used for
# app branding and Pusher/Echo client configuration in the notification bell.
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
