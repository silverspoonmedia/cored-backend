# Profile: local — development on Laragon / local machine.
# Install: php artisan env:install local
# See docs/environment.md

# --- Application ---------------------------------------------------------------
# Core Laravel identity: app name, environment, encryption keys, debug mode, and
# public base URL. APP_KEY is the active encryption key; APP_PREVIOUS_KEYS holds
# comma-separated retired keys after `php artisan key:generate --force` (Laravel
# key rotation — see config/app.php previous_keys). Empty in fresh templates.
APP_NAME="Laravel"
APP_ENV="local"
APP_KEY="base64:ZmwsT58usL28e0dKQTt5e2fNCtsvI41SmoWEWQJpY1o="
APP_PREVIOUS_KEYS=""
APP_DEBUG=false
APP_URL="https://monolith-spa-sandbox-api.spnd.uk"
# Public origin of Monolith-Vue-Workers (OAuth return_to allowlist). Empty = Blade-only return.
SPA_URL="http://localhost:5173"
# Comma-separated extra browser origins for CORS allowlist (preview URLs, localhost dev). Empty = none.
CORS_EXTRA_ORIGINS="https://monolith-spa-sandbox-api.spnd.uk"

# --- Localization --------------------------------------------------------------
# Default locale for the app, fallback when a translation is missing, and locale
# used by Faker when seeding fake data.
APP_LOCALE="en"
APP_FALLBACK_LOCALE="en"
APP_FAKER_LOCALE="en_US"

# --- Maintenance mode ----------------------------------------------------------
# How Laravel stores maintenance-mode state. Use "file" for single-server setups;
# uncomment STORE for multi-server (requires cache/database).
APP_MAINTENANCE_DRIVER="file"
# APP_MAINTENANCE_STORE="database"

# --- PHP built-in server (php artisan serve) -----------------------------------
# Uncomment to set worker count when using the CLI dev server.
# PHP_CLI_SERVER_WORKERS=4

# --- Password hashing ----------------------------------------------------------
# bcrypt cost factor. Higher = slower but more resistant to brute-force.
BCRYPT_ROUNDS=12

# --- Web frontend layout -------------------------------------------------------
# Active Blade layout directory (resources/views/{WEB_LAYOUT}/). See docs/web-frontend.md
WEB_LAYOUT="adminlte4"

# --- JWT API authentication ----------------------------------------------------
# Stateless bearer tokens for the API guard. Secret signs HS256 tokens.
# JWT TTLs / refresh skew / blacklist grace: Settings → Platform (platform.jwt.*).
