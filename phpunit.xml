<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Domain">
            <directory>tests/Domain</directory>
        </testsuite>
        <!-- One suite per core package, so a package's tests can be run alone
             while the full run still covers every tree: PHPUnit runs all suites
             in this file by default. A directory may appear in exactly one
             suite — listing it twice makes PHPUnit warn per file and turns a
             green run's exit code to 1. -->
        <testsuite name="Package:audit">
            <directory>packages/audit/tests</directory>
        </testsuite>
        <testsuite name="Package:ai">
            <directory>packages/ai/tests</directory>
        </testsuite>
        <testsuite name="Package:billing">
            <directory>packages/billing/tests</directory>
        </testsuite>
        <testsuite name="Package:navigation">
            <directory>packages/navigation/tests</directory>
        </testsuite>
        <testsuite name="Package:notification">
            <directory>packages/notification/tests</directory>
        </testsuite>
        <testsuite name="Package:platform">
            <directory>packages/platform/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>packages</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:2fl+KtvkdphvQyEfmNqD2aE7nKj8vR3xW5yZ1aB4cD8="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="APP_NOTIFICATION_TYPE" value="polling"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="JWT_SECRET" value="testing-jwt-secret-key-with-enough-length"/>
        <env name="AUTH_GUARD" value="api"/>
        <env name="AUTH_DEFAULT_ROLE" value="User"/>
        <env name="HCAPTCHA_ENABLED" value="false"/>
        <env name="ENCRYPTION_KMS_ENABLED" value="false"/>
        <env name="ENCRYPTION_BLIND_INDEX_PEPPER" value="testing-blind-index-pepper"/>
        <env name="ENCRYPTION_DECRYPTED_CACHE_MAX_TTL" value="60"/>
        <env name="ENCRYPTION_SESSION_ENABLED" value="false"/>
    </php>
</phpunit>
